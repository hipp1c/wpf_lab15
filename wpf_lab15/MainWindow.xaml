<Window x:Class="wpf_lab15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_lab15"
        mc:Ignorable="d"
        Title="Мой Дела" 
        Height="450" 
        Width="400"
        Icon="images/icon.png">

    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Background" Value="#FFFDFAF1"></Setter>
            <Setter Property="Foreground" Value="#5EBEC4"></Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontWeight" Value="Medium"></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="StrikethroughText">
            <Style.Triggers>
                <DataTrigger 
                    Binding="{Binding ElementName=CheckBox, Path=IsChecked}"
                    Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="ColorDate">
            <Setter Property="Text" Value="{Binding Path=Date, StringFormat=dd.MM.yyyy}"></Setter>
            
            <Style.Triggers>
                <DataTrigger 
                    Binding="{Binding Path=Date, Converter={StaticResource RedDayConverter}}"
                    Value="True">
                    <Setter Property="Foreground" Value="Red"></Setter>
                </DataTrigger>
                
                <DataTrigger 
                    Binding="{Binding Path=Date, Converter={StaticResource OrangeDayConverter}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFEA6A20"></Setter>
                </DataTrigger>
                
                <DataTrigger 
                    Binding="{Binding Path=Date, Converter={StaticResource YellowDayConverter}}"
                    Value="True">
                    <Setter Property="Foreground" Value="#DAA520"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="ProgressBarText"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="5"
            FontSize="20"
            FontFamily="Cascadia Mono">
        </TextBlock>

        <ProgressBar
            x:Name="ProgressBar"
            Grid.Row="2"
            Grid.ColumnSpan="2">
        </ProgressBar>

        <TextBlock
            HorizontalAlignment="Left"
            Style="{StaticResource HeaderStyle}">
            Список дел
        </TextBlock>

        <Button
            Grid.Column="1"
            HorizontalAlignment="Right"
            Margin="10"
            Click="AddToDo">
            <Image
                Source="images/add.png" Height="26" Width="55"/>
        </Button>

        <ListBox 
            Grid.Column="0"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="#FDF5DF"
            Margin="5"
            Name="listToDo"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <CheckBox 
                            Name="CheckBox"
                            Grid.Column="0"
                            Checked="CheckBoxChecked"
                            Unchecked="CheckBoxUnchecked"
                            IsChecked="{Binding Path=IsDoing}">
                        </CheckBox>

                        <TextBlock 
                            Style="{StaticResource StrikethroughText}"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Margin="5,0,0,0"
                            Text="{Binding Path=Name}">
                        </TextBlock>

                        <TextBlock 
                            Style="{StaticResource ColorDate}"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Margin="0,0,5,0"
                            Foreground="#FF71C52F">
                        </TextBlock>

                        <Button
                            Click="RemoveToDo"
                            Grid.Column="3"
                            MaxWidth="20"
                            MaxHeight="20">
                            <Image Source="images/delete.png"></Image>
                        </Button>

                        <TextBlock 
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            FontSize="10" 
                            Text="{Binding Path=Description}">
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>