<Window x:Class="wpf_lab15.TaskCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_lab15"
        mc:Ignorable="d"
        Height="450"
        Width="400"
        Background="#fffdfaf1"
        FontSize="12"
        Icon="images/icon.png">

    <Window.Resources>
        <Style x:Key="CalendarStyle" TargetType="Calendar">
            <Setter Property="BorderBrush" Value="#5EBEC4"></Setter>
            <Setter Property="BorderThickness" Value="1.5"></Setter>
            <Setter Property="Background" Value="White"></Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="SelectedDateFormat" Value="Long"></Setter>
            <Setter Property="BorderThickness" Value="1.5"></Setter>
            <Setter Property="BorderBrush" Value="#5EBEC4"></Setter>
            <Setter Property="Background" Value="White"></Setter>
            <Setter Property="CalendarStyle" Value="{StaticResource CalendarStyle}"></Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FFFFFAD6"></Setter>
                    <Setter Property="BorderThickness" Value="2"></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding
            Command="{x:Static local:TaskCreationWindow.AddTaskCommand}"
            Executed="CreateTaskButton">
        </CommandBinding>
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding
            Key="Return"
            Command="{x:Static local:TaskCreationWindow.AddTaskCommand}">
        </KeyBinding>
    </Window.InputBindings>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            Style="{StaticResource HeaderStyle}">
            Новое дело
        </TextBlock>

        <Button
            Grid.Row="2"
            MaxWidth="100"
            Margin="5"
            Command="{x:Static local:TaskCreationWindow.AddTaskCommand}">
            Сохранить дело
        </Button>

        <GroupBox
            Grid.Column="1"
            Grid.Row="1"
            Margin="5"
            Background="#FDF5DF"
            Name="groupBoxToDo">
            <StackPanel
                Margin="5">
                <TextBlock>Название</TextBlock>
                <TextBox 
                    Margin="0 5 0 10"
                    Name="titleToDo">
                </TextBox>
                <TextBlock>Выполнить до</TextBlock>
                <DatePicker 
                    Margin="0 5 0 10"
                    Name="dateToDo">
                </DatePicker>
                <TextBlock>Описание</TextBlock>
                <TextBox
                    Margin="0 5 0 10"
                    MinLines="10"
                    MaxLines="10"
                    AcceptsTab="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Visible"
                    Name="descriptionToDo">
                </TextBox>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>